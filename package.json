{
  "name": "cf-domain-search",
  "version": "0.2.0",
  "description": "Check a name's availability and price across every Cloudflare Registrar TLD",
  "license": "MIT",
  "author": "Ricardo Escobar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyeescobar/cf-domain-search.git"
  },
  "homepage": "https://github.com/rickyeescobar/cf-domain-search#readme",
  "bugs": {
    "url": "https://github.com/rickyeescobar/cf-domain-search/issues"
  },
  "type": "module",
  "bin": {
    "cf-domain-search": "dist/cfdomains.js",
    "cfdomains": "dist/cfdomains.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target=node --banner='#!/usr/bin/env node' --minify-syntax --outfile=dist/cfdomains.js",
    "check": "tsc --noEmit",
    "prepack": "bun run check && bun test && bun run build",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "cloudflare",
    "registrar",
    "domain",
    "domain-search",
    "tld",
    "cli",
    "effect"
  ]
}
